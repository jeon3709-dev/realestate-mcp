# ---------------------------------------------------------------------------
# 부동산 통합 조회 MCP 서버 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우십시오. (.env 는 .gitignore 대상)
# 키가 비어 있는 API 는 해당 도구만 에러를 반환하고, 서버는 정상 기동합니다.
# ---------------------------------------------------------------------------

# VWorld Open API 인증키 (https://www.vworld.kr)
VWORLD_API_KEY=your_api_key_here
# VWorld 요청의 domain 파라미터 / Referer 헤더 (기본 localhost)
# Cloudtype 배포 시 앱 도메인(예: my-app.cloudtype.app)으로 설정
# VWORLD_DOMAIN=localhost

# 건축HUB 건축물대장정보 서비스 인증키 (공공데이터포털 일반 인증키, Decoding 키 권장)
BLDRGST_API_KEY=your_api_key_here

# 국토교통부 실거래가 공개 API 인증키 (공공데이터포털 일반 인증키, Decoding 키 권장)
MOLIT_SERVICE_KEY=your_service_key_here

# 공공데이터포털 공용 인증키 (선택)
# BLDRGST_API_KEY / MOLIT_SERVICE_KEY 가 비어 있을 때만 대신 사용. 개별 키가 우선.
# DATA_GO_KR_SERVICE_KEY=

# 선택: 아웃바운드 HTTP 프록시
# VWORLD_PROXY_URL=http://your-proxy-server:port
# BLDRGST_PROXY_URL=http://your-proxy-server:port

# 선택: 실거래가 월별 호출 동시 실행 수 (기본 5)
# RTMS_CONCURRENCY=5

# 서버 구동 포트 (Cloudtype 은 자동 주입, 기본 8080)
PORT=8080
